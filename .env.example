# Copie este arquivo para ".env" e preencha os valores antes de iniciar o servidor.

# Senha única compartilhada pela equipe (financeiro) para entrar no app.
APP_PASSWORD=troque-esta-senha

# Chave secreta usada para assinar o cookie de sessão. Gere uma string aleatória longa com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-esta-chave-secreta

# Porta em que o servidor Node vai escutar (o Nginx faz proxy da 80/443 para essa porta).
# Nesse mesmo servidor Lightsail já rodam outros apps (posicoes-financeiras na 3000,
# trok-api na 3001, auditoria-lojas na 3002) - use uma porta livre, ex: 3003.
PORT=3003

# Deixe "true" quando o site já estiver servido via HTTPS (com domínio + certificado).
# Enquanto estiver testando só por http://IP:PORT, deixe "false".
COOKIE_SECURE=false
